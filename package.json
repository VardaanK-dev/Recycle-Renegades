{
  "name": "recycle-renegades",
  "version": "1.0.0",
  "private": true,
  "description": "Recycle Renegades — an environmental awareness website about turning mismanaged plastic into solutions. Multilingual (7 languages), SEO, theme toggle, headless and statically generated with Next.js.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:helmet": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit"
  },
  "dependencies": {
    "helmet": "^8.1.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-security": "^3.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "**/next": true,
    "**/sharp": true,
    "unrs-resolver": true
  }
}
